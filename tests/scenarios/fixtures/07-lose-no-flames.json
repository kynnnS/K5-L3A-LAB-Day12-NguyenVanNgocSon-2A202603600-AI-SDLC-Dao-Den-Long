{
  "id": "07-lose-no-flames",
  "requirement": "C8,C10",
  "description": "1 flame, shade on player -> hit then lost/no_flames at tick 1",
  "seed": 1,
  "ticks": 100,
  "snapshot_every": 10,
  "scenario": {
    "player": {
      "flames": 1,
      "carried": 3
    },
    "random_motes": false,
    "random_shades": false,
    "motes": [],
    "shades": [
      {
        "pos": [
          0.5,
          1,
          0
        ]
      }
    ]
  },
  "expect": {
    "events": [
      {
        "tick": 1,
        "name": "player_hit",
        "data": {
          "by": "shade",
          "flames": 0,
          "dropped": 1
        }
      },
      {
        "tick": 1,
        "name": "game_over",
        "data": {
          "result": "lost",
          "reason": "no_flames"
        }
      }
    ],
    "end": {
      "ticks": 1,
      "state": "lost",
      "score": 0
    }
  }
}